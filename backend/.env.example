# NodeControl License API — Environment Variables
# Copy to .env and fill in your values

SECRET_KEY=generate-a-random-hex-string-here
ADMIN_TOKEN=pick-a-strong-admin-password

# SMTP (Gmail example — use an App Password, not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=noreply@nodecontrol.io
SMTP_FROM_NAME=NodeControl

# Database
DB_PATH=licenses.db

# Download URLs (GitHub release links)
FREE_MAC_URL=https://github.com/miketpl/node-control-releases-free/releases/latest/download/Node.Control-free-0.9.17.dmg
FREE_WIN_URL=https://github.com/miketpl/node-control-releases-free/releases/latest/download/NodeControl-free-0.9.17-Setup.exe

# Code expiry in hours
CODE_EXPIRY_HOURS=72

# Server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
