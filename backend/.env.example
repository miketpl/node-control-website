# NodeControl License API — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env && nano .env

# ── Security ────────────────────────────────────────────────
SECRET_KEY=generate-a-random-hex-string-here
# Admin stays disabled while this is empty or change-me-in-production.
# Replace it with a long random secret before use. Never commit the real value.
ADMIN_TOKEN=change-me-in-production

# ── SMTP (for sending verification emails) ──────────────────
# Your custom mail server details:
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@nodecontrol.io
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@nodecontrol.io
SMTP_FROM_NAME=NodeControl

# ── Database ────────────────────────────────────────────────
DB_PATH=/opt/nodecontrol-api/licenses.db

# ── GitHub Releases (free tier downloads) ───────────────────
# Public repo containing the free .dmg and .exe release assets
FREE_RELEASES_REPO=miketpl/node-control-releases-free

# ── GitHub License Sync ─────────────────────────────────────
# Private repo where active license codes are pushed as JSON
# so the desktop app can validate on startup.
# Must match the repo the Free app reads. Singular "license-free".
LICENSE_REPO=miketpl/node-control-license-free
LICENSE_FILE=licenses.json
# Read-only PAT is enough for a manual check of licenses.json.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAT with Contents read+write on LICENSE_REPO. The API uses this to add
# and remove codes. Placeholder only — put the real token in the VPS .env.
GITHUB_PAT_WRITE=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Code Expiry ─────────────────────────────────────────────
CODE_EXPIRY_HOURS=72

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# ── Pro subscription (Stripe) ───────────────────────────────
# Placeholders only. Put the live values in the VPS .env. Never commit them.
SITE_URL=https://nodecontrol.io
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_ANNUAL=price_replace_me
# Optional. Leave empty to reuse GITHUB_PAT_WRITE. That token needs
# contents:write on miketpl/node-control-registrations (allowlist.json).
GITHUB_PAT_REGISTRATIONS=
PRO_ALLOWLIST_REPO=miketpl/node-control-registrations
PRO_ALLOWLIST_PATH=allowlist.json
PRO_RELEASES_REPO=miketpl/node-control-releases-pro
# PAT that can read release assets in the private Pro repo. Not the public free PAT.
PRO_RELEASES_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used to sign download links. If empty, SECRET_KEY is used.
PRO_DOWNLOAD_SECRET=replace-with-a-long-random-string
