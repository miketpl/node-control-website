# NodeControl License API — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env && nano .env

# ── Security ────────────────────────────────────────────────
SECRET_KEY=generate-a-random-hex-string-here
# Admin stays disabled while this is empty or change-me-in-production.
# Replace it with a long random secret before use. Never commit the real value.
ADMIN_TOKEN=change-me-in-production
# Read-only dashboard token. Empty or change-me-in-production is ignored.
# Accepted only on GET /api/admin/stats, /api/admin/stats/v1 and /api/admin/flags.
# It cannot list licences or Professional keys, or change anything.
ADMIN_READ_TOKEN=change-me-in-production

# ── SMTP (for sending verification emails) ──────────────────
# Your custom mail server details:
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@nodecontrol.io
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@nodecontrol.io
SMTP_FROM_NAME=NodeControl

# ── Database ────────────────────────────────────────────────
# The Spark reads this file from ~/node-control-website/.env (the repo
# root, beside backend/). app.py loads that path. /opt is the old recipe.
# Leave the live DB_PATH as it already is on the box.
DB_PATH=/opt/nodecontrol-api/licenses.db

# ── GitHub Releases (free tier downloads) ───────────────────
# Public repo containing the free .dmg and .exe release assets
FREE_RELEASES_REPO=miketpl/node-control-releases-free

# ── GitHub License Sync ─────────────────────────────────────
# Private repo where active license codes are pushed as JSON
# so the desktop app can validate on startup.
# Must match the repo the Free app reads. Singular "license-free".
LICENSE_REPO=miketpl/node-control-license-free
LICENSE_FILE=licenses.json
# Read-only PAT is enough for a manual check of licenses.json.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAT with Contents read+write on LICENSE_REPO. The API uses this to add
# and remove codes. Placeholder only — put the real token in the VPS .env.
GITHUB_PAT_WRITE=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Code Expiry ─────────────────────────────────────────────
CODE_EXPIRY_HOURS=72

# ── Server ──────────────────────────────────────────────────
# Optional. Short commit shown on GET /api/health. If empty, the process
# reads git rev-parse --short HEAD once at startup, then "unknown".
# GIT_SHA=
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# ── Pro subscription (Stripe) ───────────────────────────────
# Secrets stay in the VPS .env. Never commit a live secret key.
# The Price IDs below are test-mode examples, not secrets.
SITE_URL=https://nodecontrol.io
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_1URbemK9mPdHMakYFcEWDS44
STRIPE_PRICE_PRO_ANNUAL=price_1URbeoK9mPdHMakYYYxmPB5m
# Optional. Leave empty to reuse GITHUB_PAT_WRITE. That token needs
# contents:write on miketpl/node-control-registrations (allowlist.json).
GITHUB_PAT_REGISTRATIONS=
PRO_ALLOWLIST_REPO=miketpl/node-control-registrations
PRO_ALLOWLIST_PATH=allowlist.json
PRO_RELEASES_REPO=miketpl/node-control-releases-pro
# PAT that can read release assets in the private Pro repo. Not the public free PAT.
PRO_RELEASES_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used to sign download links. If empty, SECRET_KEY is used.
PRO_DOWNLOAD_SECRET=replace-with-a-long-random-string

# ── 0.9.41 licence server ───────────────────────────────────
# Placeholders only. Put the real values in ~/node-control-website/.env.
# Fine-grained PAT, contents:read on releases-free and releases-pro.
# PRO_RELEASES_PAT is the fallback if this is empty.
RELEASES_READ_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 64 hex characters, or another long random string. Required before
# checkout can store a Professional key. Never commit the real value.
KEY_ENCRYPTION_KEY=replace-with-64-hex-chars
# Empty or unset means paused. A row in server_flags overrides this
# until that row is cleared. true keeps Free downloads paused.
FREE_DOWNLOADS_PAUSED=true
# Optional. Empty uses the sentence already on the homepage.
FREE_PAUSED_MESSAGE=
MAINTENANCE=false
# Leave unset, or set 0.9.40, until 0.9.41 is published.
# Empty means no minimum. Status and update-check cap a minimum
# that is higher than the latest published release.
MIN_SUPPORTED_VERSION_FREE=
MIN_SUPPORTED_VERSION_PRO=
TELEMETRY_RETENTION_DAYS=365
TELEMETRY_ACCEPT=true
# Empty disables the registration alert. Default is this address.
REGISTRATION_ALERT_EMAIL=support@nodecontrol.io
API_PUBLIC_URL=https://api.nodecontrol.io
# Signs the one-click unsubscribe link in service notices.
# Empty or change-me-in-production means notices are not sent.
NOTICE_UNSUBSCRIBE_SECRET=change-me-in-production
# Seconds between notice emails. Empty uses 0.25.
NOTICE_THROTTLE_SECONDS=
# Leave false. While this is false the API does not read or write
# licenses.json or allowlist.json, and it does not call GitHub with
# GITHUB_PAT or GITHUB_PAT_WRITE. Set true only if a 0.9.40 client
# still checks those files. Release downloads use RELEASES_READ_PAT.
LEGACY_ALLOWLIST_SYNC=false
