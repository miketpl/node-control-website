# Old recipe. The Spark runs from ~/node-control-website and reads
# ~/node-control-website/.env. Point EnvironmentFile and WorkingDirectory
# at that checkout. cloudflared already proxies api.nodecontrol.io to
# 127.0.0.1:5000. Do not add a Cloudflare IP firewall in front of this.
[Unit]
Description=NodeControl License API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nodecontrol-api
ExecStart=/opt/nodecontrol-api/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --timeout 30 \
    --access-logfile /var/log/nodecontrol-api/access.log \
    --error-logfile /var/log/nodecontrol-api/error.log \
    app:app
EnvironmentFile=/opt/nodecontrol-api/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
